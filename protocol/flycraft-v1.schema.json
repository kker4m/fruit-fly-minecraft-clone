{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flycraft.local/protocol/flycraft-v1.schema.json",
  "title": "FlyCraft WebSocket Protocol v1",
  "oneOf": [
    {"$ref": "#/$defs/sensoryFrame"},
    {"$ref": "#/$defs/motorResponse"},
    {"$ref": "#/$defs/errorResponse"}
  ],
  "$defs": {
    "sensoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "food_distance", "food_angle", "obstacle_front", "obstacle_left", "obstacle_right", "touch", "damage", "in_water"],
      "properties": {
        "light": {"type": "number", "minimum": 0, "maximum": 15},
        "food_distance": {"type": ["number", "null"], "minimum": 0},
        "food_angle": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
        "obstacle_front": {"type": ["number", "null"], "minimum": 0},
        "obstacle_left": {"type": ["number", "null"], "minimum": 0},
        "obstacle_right": {"type": ["number", "null"], "minimum": 0},
        "touch": {"type": "boolean"},
        "damage": {"type": "boolean"},
        "in_water": {"type": "boolean"}
      }
    },
    "sensoryFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "sent_at_ms", "step_ms", "sensors"],
      "properties": {
        "type": {"const": "sensory_frame"},
        "protocol_version": {"const": 1},
        "request_id": {"type": "integer", "minimum": 0},
        "sent_at_ms": {"type": "integer", "minimum": 0},
        "step_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 200},
        "sensors": {"$ref": "#/$defs/sensoryState"}
      }
    },
    "motorCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forward", "yaw", "escape"],
      "properties": {
        "forward": {"type": "number", "minimum": -1, "maximum": 1},
        "yaw": {"type": "number", "minimum": -1, "maximum": 1},
        "escape": {"type": "boolean"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_time_ms", "brain_wall_time_ms", "round_trip_server_ms", "input_spikes", "output_spikes", "active_neurons", "stimulated_neurons", "aggregate_stimulus_rate_hz", "descending_rate_hz", "unmapped_inputs", "sensory_channel_rates_hz", "motor_population_rates_hz", "motor_side_rates_hz"],
      "properties": {
        "simulation_time_ms": {"type": "number"},
        "brain_wall_time_ms": {"type": "number", "minimum": 0},
        "round_trip_server_ms": {"type": "number", "minimum": 0},
        "input_spikes": {"type": "integer", "minimum": 0},
        "output_spikes": {"type": "integer", "minimum": 0},
        "active_neurons": {"type": "integer", "minimum": 0},
        "stimulated_neurons": {"type": "integer", "minimum": 0},
        "aggregate_stimulus_rate_hz": {"type": "number", "minimum": 0},
        "descending_rate_hz": {"type": "number", "minimum": 0},
        "unmapped_inputs": {"type": "array", "items": {"type": "string"}},
        "sensory_channel_rates_hz": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "motor_population_rates_hz": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "motor_side_rates_hz": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "motorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "command", "telemetry"],
      "properties": {
        "type": {"const": "motor_command"},
        "protocol_version": {"const": 1},
        "request_id": {"type": "integer", "minimum": 0},
        "command": {"$ref": "#/$defs/motorCommand"},
        "telemetry": {"$ref": "#/$defs/telemetry"}
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "code", "message"],
      "properties": {
        "type": {"const": "error"},
        "protocol_version": {"const": 1},
        "request_id": {"type": ["integer", "null"], "minimum": 0},
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
